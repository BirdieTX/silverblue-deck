[Unit]
Description=Configure Bluebird for the current handheld hardware
After=rpm-ostreed.service tuned.service
Before=systemd-user-sessions.service jupiter-biosupdate.service jupiter-controller-update.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bluebird-hardware-setup

[Install]
WantedBy=multi-user.target
