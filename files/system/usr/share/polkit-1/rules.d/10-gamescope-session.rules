polkit.addRule(function(action, subject) {
    if ((action.id == "org.bluebird.policykit.gamescope-session.pkexec.os-biosupdate" ||
         action.id == "org.bluebird.policykit.gamescope-session.pkexec.os-session-select") &&
         subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
