#!/usr/bin/bash
# Sets the SDDM autologin user and the default session.
# Adapted from Bazzite's bazzite-autologin (Apache-2.0).
# Bluebird changes: no image-info.json, GNOME only.

USER=$(id -nu 1000 2>/dev/null)
if [[ -z ${USER} ]]; then
  echo "No user with UID 1000, leaving autologin alone" >&2
  exit 0
fi

USER_CONF="/etc/sddm.conf.d/zz-bluebird-autologin.conf"
HOLO_CONF="/etc/sddm.conf.d/zz-holo-autologin.conf"
DESKTOP_AUTOLOGIN="/etc/bluebird/desktop_autologin"

rm -f /etc/sddm.conf.d/zz-steamos-autologin.conf \
      /etc/sddm.conf.d/steamos.conf

if [[ -f ${DESKTOP_AUTOLOGIN} ]]; then
  SESSION="gnome.desktop"
else
  SESSION="gamescope-session-ogui-steam.desktop"
fi

mkdir -p /etc/sddm.conf.d
cat > "${USER_CONF}" <<CONF
[Autologin]
User=${USER}
CONF

if [[ ! -f ${HOLO_CONF} ]]; then
  cat > "${HOLO_CONF}" <<CONF
[Autologin]
Session=${SESSION}
CONF
fi
